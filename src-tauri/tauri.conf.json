{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loors",
  "version": "0.1.0",
  "identifier": "dev.loors.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loors — Agentic Loop Studio",
        "width": 1280,
        "height": 740,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local-first AI agent and cyclic harness studio powered by llama.cpp",
    "longDescription": "Loors is a local-first desktop studio for autonomous AI agents and visual cyclic harnesses powered by an embedded llama.cpp runtime.",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Loors Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "Loors",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English", "Spanish"]
      }
    }
  }
}
